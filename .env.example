# Copy to .env and fill with YOUR project values.
# Use ONLY the publishable / anon key here — NEVER the secret or service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Canonical site origin, no trailing slash. Used for canonical URLs, og:url,
# structured data and the generated sitemap. Falls back to the browser's origin
# at runtime, but the build-time sitemap needs it set on the deploy host.
VITE_SITE_URL=https://lexusindustrial.com.ph
